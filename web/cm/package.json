{
  "name": "orbit-cm",
  "private": true,
  "description": "CodeMirror 6 bundle for Orbit: npm install && npm run build -> ../vendor/cm.js",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --global-name=CM --target=safari15 --outfile=../vendor/cm.js --legal-comments=none"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.18.6",
    "@codemirror/commands": "6.8.0",
    "@codemirror/lang-cpp": "6.0.2",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.9",
    "@codemirror/lang-java": "6.0.1",
    "@codemirror/lang-javascript": "6.2.3",
    "@codemirror/lang-json": "6.0.1",
    "@codemirror/lang-markdown": "6.3.2",
    "@codemirror/lang-python": "6.1.7",
    "@codemirror/lang-rust": "6.0.1",
    "@codemirror/lang-sql": "6.8.0",
    "@codemirror/lang-yaml": "6.1.2",
    "@codemirror/language": "6.10.8",
    "@codemirror/legacy-modes": "6.4.3",
    "@codemirror/search": "6.5.10",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.36.4",
    "@lezer/highlight": "1.2.1",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "esbuild": "0.24.2",
    "katex": "0.16.11"
  }
}
